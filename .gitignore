# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code local settings
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# raw hero frame source (encoded output lives in public/hero-frames)
/video2_frames_30fps/

# raw portrait hero frame source (encoded output lives in public/hero-frames)
/frames/

# raw mobile frame source, consolidated from the batch folders
/mobileframes/

# raw gallery photographs (packed output lives in public/_gal)
/gallery-src/
